# Copy to .env and adjust. `npm run db:up` starts the matching local Postgres.
DATABASE_URL="postgresql://fz:fz@localhost:5432/fantasticzone"
SHADOW_DATABASE_URL="postgresql://fz:fz@localhost:5432/fantasticzone_shadow"
TEST_DATABASE_URL="postgresql://fz:fz@localhost:5432/fantasticzone_test"

APP_URL="http://localhost:3000"
# 32+ random chars. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET="change-me-to-a-long-random-string-0123456789"
CURRENCY="NGN"

# console | termii | twilio
SMS_PROVIDER="console"
TERMII_API_KEY=""
TERMII_SENDER_ID="FZone"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# console | resend
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="FANTASTICZONE <hello@fantasticzone.ng>"

# console | cloud. Cloud needs Meta-approved templates named like the keys in /admin/settings.
WHATSAPP_PROVIDER="console"
WHATSAPP_MODE="template"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Protects /api/cron/notifications (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# Error tracking and product analytics. Empty = disabled.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Paystack (test keys start sk_test_). Leave empty to use bank transfer + manual mark-paid only.
PAYSTACK_SECRET_KEY=""
PAYSTACK_BASE_URL="https://api.paystack.co"

# Bank transfer details shown on unpaid product invoices (manual mark-paid by finance).
BANK_NAME="Example Bank"
BANK_ACCOUNT_NAME="FANTASTICZONE LTD"
BANK_ACCOUNT_NUMBER="0000000000"

# Non-production only: every OTP becomes this code. Leave empty to use random codes.
OTP_DEV_CODE=""
