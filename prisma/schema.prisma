// FANTASTICZONE data model. Source of truth: build spec §4.
// Money is numeric(12,2), weight is integer grams, dimensions are integer mm.
// Things Prisma cannot express (order-number sequence, the generated
// grand_total column, CHECK constraints, immutability triggers) are in the
// migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  dropshipper
  admin
  ops
  finance
  support
}

enum BatchStatus {
  collecting
  ordered
  measured
  invoiced
  shipped
  delivered
  cancelled
}

enum ShipMethod {
  sea
  air
}

enum AllocationMethod {
  weight
  volumetric
  quantity
  equal
}

enum OrderStatus {
  preorder_placed
  batch_confirmed
  measured
  invoiced
  shipping_paid
  shipped
  delivered
  cancelled
}

enum InvoiceKind {
  product
  shipping
}

enum InvoiceStatus {
  issued
  paid
  voided
  adjusted
}

enum PaymentMethod {
  card
  bank_transfer
  manual
}

enum PaymentProvider {
  paystack
  flutterwave
  stripe
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum ShipmentStatus {
  pending
  in_transit
  arrived
  delivered
}

enum NotificationChannel {
  whatsapp
  email
  in_app
}

enum NotificationStatus {
  queued
  sent
  failed
}

enum ChallengeChannel {
  sms
  email
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone             String?   @unique
  email             String?   @unique
  name              String?
  role              Role      @default(customer)
  passwordHash      String?   @map("password_hash")
  phoneVerifiedAt   DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// { whatsapp: boolean, email: boolean } for reminders. Approved addition to §4 (Phase 6).
  notificationPrefs Json      @default("{\"email\": true, \"whatsapp\": true}") @map("notification_prefs")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses           Address[]
  orders              Order[]
  notifications       Notification[]
  batchesCreated      Batch[]              @relation("BatchCreator")
  measurementsTaken   Measurement[]
  allocationsApproved ShippingAllocation[]
  auditEntries        AuditLog[]

  @@map("users")
}

model Address {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  fullName   String   @map("full_name")
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?  @map("postal_code")
  country    String   @default("NG")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  category    String?
  /// [{ url, alt, order }]
  images      Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([category])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  sku         String?  @unique
  label       String
  buyingPrice Decimal  @map("buying_price") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Batch {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  cutoffAt          DateTime          @map("cutoff_at") @db.Timestamptz(6)
  status            BatchStatus       @default(collecting)
  defaultShipMethod ShipMethod        @default(sea) @map("default_ship_method")
  shippingQuote     Decimal?          @map("shipping_quote") @db.Decimal(12, 2)
  allocationMethod  AllocationMethod? @map("allocation_method")
  createdById       String?           @map("created_by") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy   User?                @relation("BatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders      Order[]
  allocations ShippingAllocation[]
  shipments   Shipment[]

  @@index([status])
  @@map("batches")
}

model Order {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber   String      @unique @default(dbgenerated("('FZ-'::text || nextval('order_number_seq'::regclass))")) @map("order_number")
  userId        String      @map("user_id") @db.Uuid
  batchId       String?     @map("batch_id") @db.Uuid
  status        OrderStatus @default(preorder_placed)
  shipMethod    ShipMethod  @default(sea) @map("ship_method")
  productTotal  Decimal     @default(0) @map("product_total") @db.Decimal(12, 2)
  shippingTotal Decimal     @default(0) @map("shipping_total") @db.Decimal(12, 2)
  /// GENERATED ALWAYS AS (product_total + shipping_total) STORED. Never write this field.
  grandTotal    Decimal     @default(dbgenerated("(product_total + shipping_total)")) @map("grand_total") @db.Decimal(12, 2)
  shipAddressId String?     @map("ship_address_id") @db.Uuid
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  batch       Batch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  shipAddress Address?             @relation(fields: [shipAddressId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  allocations ShippingAllocation[]
  invoices    Invoice[]
  payments    Payment[]

  @@index([userId])
  @@index([batchId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  measurement Measurement?

  @@index([orderId])
  @@map("order_items")
}

model Measurement {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId  String   @unique @map("order_item_id") @db.Uuid
  /// per unit
  weightG      Int      @map("weight_g")
  lengthMm     Int?     @map("length_mm")
  widthMm      Int?     @map("width_mm")
  heightMm     Int?     @map("height_mm")
  measuredById String?  @map("measured_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem  OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  measuredBy User?     @relation(fields: [measuredById], references: [id], onDelete: SetNull)

  @@map("measurements")
}

model ShippingAllocation {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId           String           @map("batch_id") @db.Uuid
  orderId           String           @map("order_id") @db.Uuid
  method            AllocationMethod
  shippingQuote     Decimal          @map("shipping_quote") @db.Decimal(12, 2)
  totalBatchWeightG Int              @map("total_batch_weight_g")
  orderWeightG      Int              @map("order_weight_g")
  allocatedAmount   Decimal          @map("allocated_amount") @db.Decimal(12, 2)
  calculatedAt      DateTime         @map("calculated_at") @db.Timestamptz(6)
  approvedById      String?          @map("approved_by") @db.Uuid
  approvedAt        DateTime?        @map("approved_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  batch      Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  approvedBy User? @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([batchId, orderId])
  @@map("shipping_allocations")
}

model Invoice {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  kind         InvoiceKind
  version      Int           @default(1)
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("NGN")
  breakdown    Json
  status       InvoiceStatus @default(issued)
  issuedAt     DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  dueAt        DateTime?     @map("due_at") @db.Timestamptz(6)
  paidAt       DateTime?     @map("paid_at") @db.Timestamptz(6)
  supersedesId String?       @map("supersedes_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order        Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  supersedes   Invoice?  @relation("InvoiceSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Invoice[] @relation("InvoiceSupersedes")
  payments     Payment[]

  @@unique([orderId, kind, version])
  @@map("invoices")
}

model Payment {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String           @map("order_id") @db.Uuid
  invoiceId   String?          @map("invoice_id") @db.Uuid
  kind        InvoiceKind
  amount      Decimal          @db.Decimal(12, 2)
  currency    String           @default("NGN")
  method      PaymentMethod
  provider    PaymentProvider?
  providerRef String?          @map("provider_ref")
  status      PaymentStatus    @default(pending)
  paidAt      DateTime?        @map("paid_at") @db.Timestamptz(6)
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  // Webhook idempotency (hard rule 6): one row per provider reference.
  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Shipment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId        String         @map("batch_id") @db.Uuid
  method         ShipMethod
  carrier        String?
  trackingNumber String?        @map("tracking_number")
  estimatedDays  Int?           @map("estimated_days")
  departedAt     DateTime?      @map("departed_at") @db.Timestamptz(6)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(6)
  status         ShipmentStatus @default(pending)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@map("shipments")
}

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  template  String
  payload   Json
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(6)
  status    NotificationStatus  @default(queued)
  error     String?
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// e.g. measurement.updated
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

/// Single-row configuration table.
model Setting {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currency              String   @default("NGN")
  volumetricDivisor     Int      @default(5000) @map("volumetric_divisor")
  notificationTemplates Json     @default("{}") @map("notification_templates")
  roleConfig            Json     @default("{}") @map("role_config")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

/// OTP codes and magic-link tokens. Approved addition to §4 (Phase 1).
model AuthChallenge {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel    ChallengeChannel
  /// E.164 phone or lower-cased email
  target     String
  codeHash   String           @map("code_hash")
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  attempts   Int              @default(0)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([target, createdAt])
  @@map("auth_challenges")
}
